// ВРЕМЕННЫЙ служебный модуль для проверки лабораторных: заполняет тестовые данные,
// проводит документы и пишет отчёт проверки в verify.txt рядом с файлом базы.
// Запускается только если рядом с базой лежит файл run.flag. Перед сдачей можно удалить.

Функция КаталогБазы()
	Возврат "C:\Users\nikak\Projects\1c-labs-ib\";
КонецФункции

Процедура ЗаписатьЛог(Лог, Текст)
	Лог.Добавить(Текст);
КонецПроцедуры

Функция НайтиСоздать(Менеджер, Наименование, ЭтоГруппа = Ложь, Родитель = Неопределено)
	Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;
	Если ЭтоГруппа Тогда
		Объект = Менеджер.СоздатьГруппу();
	Иначе
		Объект = Менеджер.СоздатьЭлемент();
	КонецЕсли;
	Объект.Наименование = Наименование;
	Если Родитель <> Неопределено Тогда
		Объект.Родитель = Родитель;
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция СтрокаДок(Номенклатура, Количество, Цена)
	Возврат Новый Структура("Номенклатура,Количество,Цена", Номенклатура, Количество, Цена);
КонецФункции

// Создаёт запрос и возвращает результат в виде текста для лога
Функция ТекстЗапроса(ТекстЗапр, Параметры = Неопределено)
	Запрос = Новый Запрос(ТекстЗапр);
	Если Параметры <> Неопределено Тогда
		Для Каждого П Из Параметры Цикл
			Запрос.УстановитьПараметр(П.Ключ, П.Значение);
		КонецЦикла;
	КонецЕсли;
	Результат = Запрос.Выполнить();
	Колонки = Результат.Колонки;
	Строки = Новый Массив;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Части = Новый Массив;
		Для Каждого К Из Колонки Цикл
			Части.Добавить(Строка(Выборка[К.Имя]));
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Части, " | "));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции


//// Вспомогательное: выполнение отчёта на СКД и вывод результата текстом
Функция ТекстОтчета(ИмяОтчета, Параметры = Неопределено, ИмяМакета = "ОсновнаяСхемаКомпоновкиДанных", ВариантНастроек = Неопределено)
	Схема = Отчеты[ИмяОтчета].ПолучитьМакет(ИмяМакета);
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Если ВариантНастроек = Неопределено Тогда
		Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Иначе
		Компоновщик.ЗагрузитьНастройки(Схема.ВариантыНастроек[ВариантНастроек].Настройки);
	КонецЕсли;
	Если Параметры <> Неопределено Тогда
		Для Каждого П Из Параметры Цикл
			Параметр = Компоновщик.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(П.Ключ));
			Если Параметр <> Неопределено Тогда
				Параметр.Использование = Истина;
				Параметр.Значение = П.Значение;
			Иначе
				Возврат "!!! параметр не найден: " + П.Ключ;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Компоновщик.ПолучитьНастройки(), , , Тип("ГенераторМакетаКомпоновкиДанных"));
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	Документ = Новый ТабличныйДокумент;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	Вывод.УстановитьДокумент(Документ);
	Вывод.Вывести(Процессор);
	Строки = Новый Массив;
	Для Стр = 1 По Документ.ВысотаТаблицы Цикл
		Части = Новый Массив;
		Для Кол = 1 По Документ.ШиринаТаблицы Цикл
			Текст = СокрЛП(Документ.Область(Стр, Кол, Стр, Кол).Текст);
			Если Текст <> "" Тогда
				Части.Добавить(Текст);
			КонецЕсли;
		КонецЦикла;
		Если Части.Количество() > 0 Тогда
			Строки.Добавить(СтрСоединить(Части, " | "));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции


//// ЛАБЫ 2-3: справочники и документы
Процедура Заполнить_1_Справочники(Лог)
	Районы = Новый Структура;
	Для Каждого Имя Из СтрРазделить("Ленинский,Заволжский,Засвияжский,Железнодорожный", ",") Цикл
		Районы.Вставить("Р" + Районы.Количество(), НайтиСоздать(Справочники.Районы, Имя));
	КонецЦикла;
	Клиенты = Новый Массив;
	Клиенты.Добавить(Новый Структура("Имя,Район", "Иванов Сергей", "Р0"));
	Клиенты.Добавить(Новый Структура("Имя,Район", "Петрова Анна", "Р1"));
	Клиенты.Добавить(Новый Структура("Имя,Район", "Сидоров Олег", "Р2"));
	Клиенты.Добавить(Новый Структура("Имя,Район", "Кузнецов Дмитрий", "Р3"));
	Клиенты.Добавить(Новый Структура("Имя,Район", "ООО Автотранс", "Р0"));
	Клиенты.Добавить(Новый Структура("Имя,Район", "Морозова Елена", "Р1"));
