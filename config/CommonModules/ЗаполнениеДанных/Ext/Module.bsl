	КонецЦикла;
	Мастера = Новый Массив;
	Мастера.Добавить(Новый Структура("Имя,Должность,Дата", "Орлов Виктор", "Автомеханик", '20200301'));
	Мастера.Добавить(Новый Структура("Имя,Должность,Дата", "Волков Игорь", "Диагност", '20210915'));
	Мастера.Добавить(Новый Структура("Имя,Должность,Дата", "Лебедев Артём", "Шиномонтажник", '20230112'));
	Для Каждого М Из Мастера Цикл
		Ссылка = Справочники.Сотрудники.НайтиПоНаименованию(М.Имя, Истина);
		Если Ссылка.Пустая() Тогда
			Объект = Справочники.Сотрудники.СоздатьЭлемент();
