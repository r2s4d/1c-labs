КонецПроцедуры

//// ЛАБА 5: макеты и печатные формы
Процедура Проверка_Лаб5(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 5 ===");
	Для Каждого Имя Из Новый Структура("ОказаниеУслуги,ПриходнаяНакладная") Цикл
		Выборка = Документы[Имя.Ключ].Выбрать();
		Если Выборка.Следующий() Тогда
			Масс = Новый Массив;
			Масс.Добавить(Выборка.Ссылка);
			ТабДок = Новый ТабличныйДокумент;
			Документы[Имя.Ключ].Печать(ТабДок, Масс, Неопределено, "Печать");
			ЗаписатьЛог(Лог, "--- Печать " + Имя.Ключ + " " + Выборка.Номер + " ---");
			Для Стр = 1 По ТабДок.ВысотаТаблицы Цикл
				Части = Новый Массив;
				Для Кол = 1 По ТабДок.ШиринаТаблицы Цикл
					Т = СокрЛП(ТабДок.Область(Стр, Кол, Стр, Кол).Текст);
					Если Т <> "" Тогда
						Части.Добавить(Т);
					КонецЕсли;
				КонецЦикла;
				ЗаписатьЛог(Лог, СтрСоединить(Части, " | "));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

//// ЛАБА 6: регистр сведений Цены, подстановка цены по дате документа
Процедура УстановитьЦену(Номенклатура, Период, Цена)
	МЗ = РегистрыСведений.Цены.СоздатьМенеджерЗаписи();
	МЗ.Период = Период;
	МЗ.Номенклатура = Номенклатура;
	МЗ.Прочитать();
	Если МЗ.Выбран() Тогда
		Возврат;
	КонецЕсли;
	МЗ.Период = Период;
	МЗ.Номенклатура = Номенклатура;
	МЗ.Цена = Цена;
	МЗ.Записать();
КонецПроцедуры

Функция ТаблицаЦен()
	Т = Новый Массив;
	// Услуги
	Т.Добавить(Новый Структура("Имя,Март,Апрель", "Замена масла двигателя", 1500, 1600));
	Т.Добавить(Новый Структура("Имя,Март,Апрель", "Компьютерная диагностика", 2000, 2200));
