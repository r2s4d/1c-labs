Процедура Заполнить_7_ДанныеДляСоединений(Лог)
	Для Каждого Имя Из СтрРазделить("Новый город,Центральный,Северный", ",") Цикл
		НайтиСоздать(Справочники.Районы, Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Беляев Андрей,Григорьев Павел", ",") Цикл
		Если Справочники.Клиенты.НайтиПоНаименованию(Имя, Истина).Пустая() Тогда
			Объект = Справочники.Клиенты.СоздатьЭлемент();
			Объект.Наименование = Имя;
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

