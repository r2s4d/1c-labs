Процедура Заполнить_3_Цены(Лог)
	Для Каждого С Из ТаблицаЦен() Цикл
		Н = НомК(С.Имя);
		УстановитьЦену(Н, '20260301', С.Март);
		УстановитьЦену(Н, '20260401', С.Апрель);
	КонецЦикла;
КонецПроцедуры

Процедура Проверка_Лаб6(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 6 ===");
	ЗаписатьЛог(Лог, "Записей в регистре Цены (ожидается 16): " + ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрСведений.Цены КАК Р"));
	ЗаписатьЛог(Лог, "Цены (номенклатура | период | цена):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Р.Номенклатура.Наименование, Р.Период, Р.Цена ИЗ РегистрСведений.Цены КАК Р УПОРЯДОЧИТЬ ПО Р.Номенклатура.Наименование, Р.Период"));
	ЗаписатьЛог(Лог, "Проверка функции РозничнаяЦена (номенклатура | на 15.03 | на 15.04 | вывод):");
	Для Каждого С Из ТаблицаЦен() Цикл
		Н = НомК(С.Имя);
		ЦенаМарт = РаботаСоСправочниками.РозничнаяЦена('20260315', Н);
		ЦенаАпрель = РаботаСоСправочниками.РозничнаяЦена('20260415', Н);
		Итог = ?(ЦенаМарт = С.Март И ЦенаАпрель = С.Апрель, "OK", "!!! ожидалось " + Строка(С.Март) + " / " + Строка(С.Апрель));
		ЗаписатьЛог(Лог, С.Имя + " | " + Строка(ЦенаМарт) + " | " + Строка(ЦенаАпрель) + " | " + Итог);
	КонецЦикла;
	// Дата раньше первой цены: цены ещё нет, функция должна вернуть 0
	ЦенаДо = РаботаСоСправочниками.РозничнаяЦена('20260101', НомК("Шиномонтаж"));
	ЗаписатьЛог(Лог, "Цена Шиномонтажа на 01.01.2026 (до первой записи, ожидается 0): " + ЦенаДо + " | " + ?(ЦенаДо = 0, "OK", "!!! ожидался 0"));
КонецПроцедуры

//// ЛАБА 7: перечисление ВидыНоменклатуры
Процедура Заполнить_4_ВидыНоменклатуры(Лог)
	// Вид номенклатуры по группе справочника: Услуги -> Услуга, Материалы -> Материал
	Выборка = Справочники.Номенклатура.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		ИмяГруппы = Выборка.Родитель.Наименование;
		Если ИмяГруппы = "Услуги" Тогда
			Нужный = Перечисления.ВидыНоменклатуры.Услуга;
		ИначеЕсли ИмяГруппы = "Материалы" Тогда
			Нужный = Перечисления.ВидыНоменклатуры.Материал;
		Иначе
			Продолжить;
		КонецЕсли;
		Если Выборка.ВидНоменклатуры <> Нужный Тогда
			Объект = Выборка.ПолучитьОбъект();
			Объект.ВидНоменклатуры = Нужный;
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;
	// Перепроведение всех документов ОказаниеУслуги по новому алгоритму
	Выборка = Документы.ОказаниеУслуги.Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Выборка.ПолучитьОбъект();
		Док.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
КонецПроцедуры

Процедура Проверка_Лаб7(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 7 ===");
	ЗаписатьЛог(Лог, "Номенклатура (наименование | вид | группа):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Н.Наименование, Н.ВидНоменклатуры, Н.Родитель.Наименование ИЗ Справочник.Номенклатура КАК Н ГДЕ НЕ Н.ЭтоГруппа УПОРЯДОЧИТЬ ПО Н.Родитель.Наименование, Н.Наименование"));
	БезВида = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Справочник.Номенклатура КАК Н ГДЕ НЕ Н.ЭтоГруппа И Н.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПустаяСсылка)");
	ЗаписатьЛог(Лог, "Элементов без вида (ожидается 0): " + БезВида + " | " + ?(БезВида = "0", "OK", "!!! у части элементов вид не задан"));
	Услуг = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.ОстаткиМатериалов КАК Р ГДЕ Р.Материал.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)");
	ЗаписатьЛог(Лог, "Записей регистра ОстаткиМатериалов по услугам (ожидается 0): " + Услуг + " | " + ?(Услуг = "0", "OK", "!!! услуги попали в регистр"));
	ДвижМат = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.ОстаткиМатериалов КАК Р ГДЕ ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(Документ.ОказаниеУслуги)");
	СтрокМат = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.ОказаниеУслуги.ПереченьНоменклатуры КАК Т ГДЕ Т.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материал) И Т.Ссылка.Проведен");
	ЗаписатьЛог(Лог, "Движений расхода: " + ДвижМат + ", строк-материалов в проведённых документах: " + СтрокМат + " | " + ?(ДвижМат = СтрокМат, "OK", "!!! не совпадают"));
	ЗаписатьЛог(Лог, "Движения ОказаниеУслуги (дата | материал | склад | количество):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Р.Период, Р.Материал.Наименование, Р.Склад.Наименование, Р.Количество ИЗ РегистрНакопления.ОстаткиМатериалов КАК Р ГДЕ ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(Документ.ОказаниеУслуги) УПОРЯДОЧИТЬ ПО Р.Период"));
КонецПроцедуры

Процедура Вызвать(Имя, Лог)
	Попытка
		Выполнить(Имя + "(Лог);");
	Исключение
		ЗаписатьЛог(Лог, "ОШИБКА в " + Имя + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Возвращает Истина, если был выполнен прогон.
Функция Запустить() Экспорт
	Флаг = Новый Файл(КаталогБазы() + "run.flag");
	Если Не Флаг.Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	Лог = Новый Массив;
	ЗаписатьЛог(Лог, "Старт: " + Строка(ТекущаяДата()));
	Вызвать("Заполнить_1_Справочники", Лог);
	Вызвать("Заполнить_2_Документы", Лог);
	Вызвать("Заполнить_3_Цены", Лог);
	Вызвать("Заполнить_4_ВидыНоменклатуры", Лог);
	Вызвать("Проверка_Лаб2_3", Лог);
	Вызвать("Проверка_Лаб4", Лог);
	Вызвать("Проверка_Лаб5", Лог);
	Вызвать("Проверка_Лаб6", Лог);
	Вызвать("Проверка_Лаб7", Лог);
	ЗаписатьЛог(Лог, "Конец: " + Строка(ТекущаяДата()));
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(СтрСоединить(Лог, Символы.ПС));
	Текст.Записать(КаталогБазы() + "verify.txt", КодировкаТекста.UTF8);
	УдалитьФайлы(КаталогБазы() + "run.flag");
	Возврат Истина;
КонецФункции
