//// ЛАБА 7: перечисление ВидыНоменклатуры
Процедура Заполнить_4_ВидыНоменклатуры(Лог)
	// Вид номенклатуры по группе справочника: Услуги -> Услуга, Материалы -> Материал
	Выборка = Справочники.Номенклатура.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		ИмяГруппы = Выборка.Родитель.Наименование;
		Если ИмяГруппы = "Услуги" Тогда
			Нужный = Перечисления.ВидыНоменклатуры.Услуга;
		ИначеЕсли ИмяГруппы = "Материалы" Тогда
			Нужный = Перечисления.ВидыНоменклатуры.Материал;
		Иначе
			Продолжить;
		КонецЕсли;
		Если Выборка.ВидНоменклатуры <> Нужный Тогда
			Объект = Выборка.ПолучитьОбъект();
			Объект.ВидНоменклатуры = Нужный;
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;
	// Перепроведение всех документов ОказаниеУслуги по новому алгоритму
	Выборка = Документы.ОказаниеУслуги.Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Выборка.ПолучитьОбъект();
		Док.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
КонецПроцедуры

Процедура Проверка_Лаб7(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 7 ===");
	ЗаписатьЛог(Лог, "Номенклатура (наименование | вид | группа):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Н.Наименование, Н.ВидНоменклатуры, Н.Родитель.Наименование ИЗ Справочник.Номенклатура КАК Н ГДЕ НЕ Н.ЭтоГруппа УПОРЯДОЧИТЬ ПО Н.Родитель.Наименование, Н.Наименование"));
	БезВида = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Справочник.Номенклатура КАК Н ГДЕ НЕ Н.ЭтоГруппа И Н.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ПустаяСсылка)");
	ЗаписатьЛог(Лог, "Элементов без вида (ожидается 0): " + БезВида + " | " + ?(БезВида = "0", "OK", "!!! у части элементов вид не задан"));
	Услуг = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.ОстаткиМатериалов КАК Р ГДЕ Р.Материал.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)");
	ЗаписатьЛог(Лог, "Записей регистра ОстаткиМатериалов по услугам (ожидается 0): " + Услуг + " | " + ?(Услуг = "0", "OK", "!!! услуги попали в регистр"));
	ДвижМат = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.ОстаткиМатериалов КАК Р ГДЕ ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(Документ.ОказаниеУслуги)");
	СтрокМат = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.ОказаниеУслуги.ПереченьНоменклатуры КАК Т ГДЕ Т.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материал) И Т.Ссылка.Проведен");
	ЗаписатьЛог(Лог, "Движений расхода: " + ДвижМат + ", строк-материалов в проведённых документах: " + СтрокМат + " | " + ?(ДвижМат = СтрокМат, "OK", "!!! не совпадают"));
	ЗаписатьЛог(Лог, "Движения ОказаниеУслуги (дата | материал | склад | количество):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Р.Период, Р.Материал.Наименование, Р.Склад.Наименование, Р.Количество ИЗ РегистрНакопления.ОстаткиМатериалов КАК Р ГДЕ ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(Документ.ОказаниеУслуги) УПОРЯДОЧИТЬ ПО Р.Период"));
КонецПроцедуры

//// ЛАБА 8: регистр СтоимостьМатериалов, проведение по двум регистрам
Процедура СоздатьОказаниеПоЦенам(Дата, Склад, Клиент, Мастер, Строки)
	// Цена берётся из регистра Цены на дату документа (стоимость списания считает проведение по среднему, лаба 14)
	Док = Документы.ОказаниеУслуги.СоздатьДокумент();
	Док.Дата = Дата;
	Док.Склад = Склад;
	Док.Клиент = Клиент;
	Док.Мастер = Мастер;
	Для Каждого С Из Строки Цикл
		Н = Док.ПереченьНоменклатуры.Добавить();
		Н.Номенклатура = С.Номенклатура;
		Н.Количество = С.Количество;
		Н.Цена = РаботаСоСправочниками.РозничнаяЦена(Дата, С.Номенклатура);
		Н.Сумма = Н.Количество * Н.Цена;
	КонецЦикла;
	Док.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура Заполнить_5_СтоимостьМатериалов(Лог)
	Основной = Справочники.Склады.Основной;
	Запчасти = Справочники.Склады.НайтиПоНаименованию("Склад запчастей", Истина);
	Кл = Справочники.Клиенты; Сот = Справочники.Сотрудники;
	// Ещё несколько документов Оказание услуги (понадобятся в следующих лабах)
	ЗпКол = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ Документ.ОказаниеУслуги");
	КолДок = ЗпКол.Выполнить().Выгрузить()[0].Кол;
	Если КолДок < 8 Тогда
		Стр = Новый Массив; Стр.Добавить(СтрокаДок(НомК("Замена масла двигателя"), 1, 0)); Стр.Добавить(СтрокаДок(НомК("Масло моторное 5W-40"), 2, 0)); Стр.Добавить(СтрокаДок(НомК("Фильтр масляный"), 1, 0));
		СоздатьОказаниеПоЦенам('20260427', Основной, Кл.НайтиПоНаименованию("Иванов Сергей", Истина), Сот.НайтиПоНаименованию("Орлов Виктор", Истина), Стр);
		Стр = Новый Массив; Стр.Добавить(СтрокаДок(НомК("Замена тормозных колодок"), 1, 0)); Стр.Добавить(СтрокаДок(НомК("Колодки тормозные (комплект)"), 1, 0));
		СоздатьОказаниеПоЦенам('20260428', Запчасти, Кл.НайтиПоНаименованию("Сидоров Олег", Истина), Сот.НайтиПоНаименованию("Орлов Виктор", Истина), Стр);
	КонецЕсли;
	// Перепроведение документов Оказание услуги (движения по регистру стоимости)
	Выборка = Документы.ОказаниеУслуги.Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Выборка.ПолучитьОбъект();
		Док.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	// Перепроведение приходных накладных (новые записи в регистре стоимости)
	Выборка = Документы.ПриходнаяНакладная.Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Выборка.ПолучитьОбъект();
		Док.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
КонецПроцедуры

Функция СравнитьОтчёт(Подпись, Факт, Ожидалось)
	Возврат Подпись + ": " + Факт + " (ожидалось " + Ожидалось + ") | " + ?(Факт = Ожидалось, "OK", "!!! расхождение");
КонецФункции

Процедура Проверка_Лаб8(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 8 ===");
	Мат = "ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материал)";
	// Приходные накладные: записи и суммы
	ЗаписатьЛог(Лог, СравнитьОтчёт("Приход: записей в СтоимостьМатериалов",
		ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.СтоимостьМатериалов КАК Р ГДЕ ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(Документ.ПриходнаяНакладная)"),
		ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.ПриходнаяНакладная.Материалы КАК Т ГДЕ Т.Ссылка.Проведен")));
	ЗаписатьЛог(Лог, СравнитьОтчёт("Приход: сумма стоимости",
		ТекстЗапроса("ВЫБРАТЬ СУММА(Р.Стоимость) ИЗ РегистрНакопления.СтоимостьМатериалов КАК Р ГДЕ ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(Документ.ПриходнаяНакладная)"),
		ТекстЗапроса("ВЫБРАТЬ СУММА(Т.Сумма) ИЗ Документ.ПриходнаяНакладная.Материалы КАК Т ГДЕ Т.Ссылка.Проведен")));
	// Оказание услуги: только материалы, стоимость = количество * стоимость
	ЗаписатьЛог(Лог, СравнитьОтчёт("Расход: записей в СтоимостьМатериалов",
		ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.СтоимостьМатериалов КАК Р ГДЕ ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(Документ.ОказаниеУслуги)"),
		ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.ОказаниеУслуги.ПереченьНоменклатуры КАК Т ГДЕ Т.Ссылка.Проведен И Т.Номенклатура.ВидНоменклатуры = " + Мат)));
	// Стоимость расхода считает проведение по среднему (лаба 14): проверяем, что она положительная
	РасходСтоимость = ТекстЗапроса("ВЫБРАТЬ СУММА(Р.Стоимость) ИЗ РегистрНакопления.СтоимостьМатериалов КАК Р ГДЕ ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(Документ.ОказаниеУслуги)");
	ЗаписатьЛог(Лог, "Расход: сумма стоимости по среднему: " + РасходСтоимость + " | " + ?(РасходСтоимость <> "0" И РасходСтоимость <> "NULL", "OK", "!!! стоимость расхода не рассчитана"));
	ЗаписатьЛог(Лог, "Остатки по стоимости (материал | стоимость):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ О.Материал.Наименование, О.СтоимостьОстаток ИЗ РегистрНакопления.СтоимостьМатериалов.Остатки КАК О УПОРЯДОЧИТЬ ПО О.Материал.Наименование"));
	ЗаписатьЛог(Лог, "Документы Оказание услуги (дата | номер | проведён):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Д.Дата, Д.Номер, Д.Проведен ИЗ Документ.ОказаниеУслуги КАК Д УПОРЯДОЧИТЬ ПО Д.Дата"));
КонецПроцедуры

