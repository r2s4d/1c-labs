// ВРЕМЕННЫЙ служебный модуль для проверки лабораторных: заполняет тестовые данные,
// проводит документы и пишет отчёт проверки в verify.txt рядом с файлом базы.
// Запускается только если рядом с базой лежит файл run.flag. Перед сдачей можно удалить.

Функция КаталогБазы()
	Возврат "C:\Users\nikak\Projects\1c-labs-ib\";
КонецФункции

Процедура ЗаписатьЛог(Лог, Текст)
	Лог.Добавить(Текст);
КонецПроцедуры

Функция НайтиСоздать(Менеджер, Наименование, ЭтоГруппа = Ложь, Родитель = Неопределено)
	Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;
	Если ЭтоГруппа Тогда
		Объект = Менеджер.СоздатьГруппу();
	Иначе
		Объект = Менеджер.СоздатьЭлемент();
	КонецЕсли;
	Объект.Наименование = Наименование;
	Если Родитель <> Неопределено Тогда
		Объект.Родитель = Родитель;
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция СтрокаДок(Номенклатура, Количество, Цена)
	Возврат Новый Структура("Номенклатура,Количество,Цена", Номенклатура, Количество, Цена);
КонецФункции

// Создаёт запрос и возвращает результат в виде текста для лога
Функция ТекстЗапроса(ТекстЗапр, Параметры = Неопределено)
	Запрос = Новый Запрос(ТекстЗапр);
	Если Параметры <> Неопределено Тогда
		Для Каждого П Из Параметры Цикл
			Запрос.УстановитьПараметр(П.Ключ, П.Значение);
		КонецЦикла;
	КонецЕсли;
	Результат = Запрос.Выполнить();
	Колонки = Результат.Колонки;
	Строки = Новый Массив;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Части = Новый Массив;
		Для Каждого К Из Колонки Цикл
			Части.Добавить(Строка(Выборка[К.Имя]));
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Части, " | "));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции


//// ЛАБЫ 2-3: справочники и документы
Процедура Заполнить_1_Справочники(Лог)
	Районы = Новый Структура;
	Для Каждого Имя Из СтрРазделить("Ленинский,Заволжский,Засвияжский,Железнодорожный", ",") Цикл
		Районы.Вставить("Р" + Районы.Количество(), НайтиСоздать(Справочники.Районы, Имя));
	КонецЦикла;
	Клиенты = Новый Массив;
	Клиенты.Добавить(Новый Структура("Имя,Район", "Иванов Сергей", "Р0"));
	Клиенты.Добавить(Новый Структура("Имя,Район", "Петрова Анна", "Р1"));
	Клиенты.Добавить(Новый Структура("Имя,Район", "Сидоров Олег", "Р2"));
	Клиенты.Добавить(Новый Структура("Имя,Район", "Кузнецов Дмитрий", "Р3"));
	Клиенты.Добавить(Новый Структура("Имя,Район", "ООО Автотранс", "Р0"));
	Клиенты.Добавить(Новый Структура("Имя,Район", "Морозова Елена", "Р1"));
	Для Каждого К Из Клиенты Цикл
		Ссылка = Справочники.Клиенты.НайтиПоНаименованию(К.Имя, Истина);
		Если Ссылка.Пустая() Тогда
			Объект = Справочники.Клиенты.СоздатьЭлемент();
			Объект.Наименование = К.Имя;
			Объект.Район = Районы[К.Район];
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;
	Мастера = Новый Массив;
	Мастера.Добавить(Новый Структура("Имя,Должность,Дата", "Орлов Виктор", "Автомеханик", '20200301'));
	Мастера.Добавить(Новый Структура("Имя,Должность,Дата", "Волков Игорь", "Диагност", '20210915'));
	Мастера.Добавить(Новый Структура("Имя,Должность,Дата", "Лебедев Артём", "Шиномонтажник", '20230112'));
	Для Каждого М Из Мастера Цикл
		Ссылка = Справочники.Сотрудники.НайтиПоНаименованию(М.Имя, Истина);
		Если Ссылка.Пустая() Тогда
			Объект = Справочники.Сотрудники.СоздатьЭлемент();
			Объект.Наименование = М.Имя;
			Объект.Должность = М.Должность;
			Объект.ДатаПриема = М.Дата;
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;
	НайтиСоздать(Справочники.Склады, "Склад запчастей");
	ГруппаУслуги = НайтиСоздать(Справочники.Номенклатура, "Услуги", Истина);
	ГруппаМатериалы = НайтиСоздать(Справочники.Номенклатура, "Материалы", Истина);
	Для Каждого Имя Из СтрРазделить("Замена масла двигателя,Компьютерная диагностика,Замена тормозных колодок,Шиномонтаж", ",") Цикл
		НайтиСоздать(Справочники.Номенклатура, Имя, Ложь, ГруппаУслуги);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Масло моторное 5W-40,Фильтр масляный,Колодки тормозные (комплект),Антифриз G12 (5 л)", ",") Цикл
		НайтиСоздать(Справочники.Номенклатура, Имя, Ложь, ГруппаМатериалы);
	КонецЦикла;
КонецПроцедуры

Функция НомК(Имя)
	Возврат Справочники.Номенклатура.НайтиПоНаименованию(Имя, Истина);
КонецФункции

Процедура СоздатьПриходную(Дата, Склад, Строки)
	Док = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Док.Дата = Дата;
	Док.Склад = Склад;
	Для Каждого С Из Строки Цикл
		Н = Док.Материалы.Добавить();
		Н.Материал = С.Номенклатура;
		Н.Количество = С.Количество;
		Н.Цена = С.Цена;
		Н.Сумма = С.Количество * С.Цена;
	КонецЦикла;
	Док.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура СоздатьОказание(Дата, Склад, Клиент, Мастер, Строки)
	Док = Документы.ОказаниеУслуги.СоздатьДокумент();
	Док.Дата = Дата;
	Док.Склад = Склад;
	Док.Клиент = Клиент;
	Док.Мастер = Мастер;
	Для Каждого С Из Строки Цикл
		Н = Док.ПереченьНоменклатуры.Добавить();
		Н.Номенклатура = С.Номенклатура;
		Н.Количество = С.Количество;
		Н.Цена = С.Цена;
		Н.Сумма = С.Количество * С.Цена;
	КонецЦикла;
	Док.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура Заполнить_2_Документы(Лог)
	Если Документы.ПриходнаяНакладная.Выбрать().Следующий() Тогда
		Возврат;
	КонецЕсли;
	Основной = Справочники.Склады.Основной;
	Запчасти = Справочники.Склады.НайтиПоНаименованию("Склад запчастей", Истина);
	М = НомК("Масло моторное 5W-40"); Ф = НомК("Фильтр масляный"); К = НомК("Колодки тормозные (комплект)"); А = НомК("Антифриз G12 (5 л)");
	ЗамМасла = НомК("Замена масла двигателя"); Диагн = НомК("Компьютерная диагностика"); ЗамКол = НомК("Замена тормозных колодок"); Шино = НомК("Шиномонтаж");

	Стр = Новый Массив; Стр.Добавить(СтрокаДок(М, 20, 3200)); Стр.Добавить(СтрокаДок(Ф, 30, 450));
	СоздатьПриходную('20260302', Основной, Стр);
	Стр = Новый Массив; Стр.Добавить(СтрокаДок(К, 10, 4800)); Стр.Добавить(СтрокаДок(А, 15, 1500));
	СоздатьПриходную('20260310', Запчасти, Стр);
	Стр = Новый Массив; Стр.Добавить(СтрокаДок(Ф, 40, 450)); Стр.Добавить(СтрокаДок(А, 10, 1500));
	СоздатьПриходную('20260320', Основной, Стр);
	Стр = Новый Массив; Стр.Добавить(СтрокаДок(М, 25, 3400)); Стр.Добавить(СтрокаДок(К, 8, 5000));
	СоздатьПриходную('20260402', Основной, Стр);
	Стр = Новый Массив; Стр.Добавить(СтрокаДок(М, 15, 3400)); Стр.Добавить(СтрокаДок(Ф, 20, 480));
	СоздатьПриходную('20260412', Запчасти, Стр);
	Стр = Новый Массив; Стр.Добавить(СтрокаДок(А, 12, 1600)); Стр.Добавить(СтрокаДок(Ф, 25, 480));
	СоздатьПриходную('20260422', Основной, Стр);

	Кл = Справочники.Клиенты; Сот = Справочники.Сотрудники;
	Стр = Новый Массив; Стр.Добавить(СтрокаДок(ЗамМасла, 1, 1500)); Стр.Добавить(СтрокаДок(М, 1, 3200)); Стр.Добавить(СтрокаДок(Ф, 1, 450));
	СоздатьОказание('20260305', Основной, Кл.НайтиПоНаименованию("Иванов Сергей", Истина), Сот.НайтиПоНаименованию("Орлов Виктор", Истина), Стр);
	Стр = Новый Массив; Стр.Добавить(СтрокаДок(Диагн, 1, 2000));
	СоздатьОказание('20260312', Запчасти, Кл.НайтиПоНаименованию("Петрова Анна", Истина), Сот.НайтиПоНаименованию("Волков Игорь", Истина), Стр);
	Стр = Новый Массив; Стр.Добавить(СтрокаДок(ЗамКол, 1, 3000)); Стр.Добавить(СтрокаДок(К, 1, 4800));
	СоздатьОказание('20260318', Запчасти, Кл.НайтиПоНаименованию("Сидоров Олег", Истина), Сот.НайтиПоНаименованию("Орлов Виктор", Истина), Стр);
	Стр = Новый Массив; Стр.Добавить(СтрокаДок(Шино, 1, 2400)); Стр.Добавить(СтрокаДок(А, 1, 1500));
	СоздатьОказание('20260405', Основной, Кл.НайтиПоНаименованию("Кузнецов Дмитрий", Истина), Сот.НайтиПоНаименованию("Лебедев Артём", Истина), Стр);
	Стр = Новый Массив; Стр.Добавить(СтрокаДок(Диагн, 2, 2000)); Стр.Добавить(СтрокаДок(Ф, 2, 480));
	СоздатьОказание('20260415', Запчасти, Кл.НайтиПоНаименованию("ООО Автотранс", Истина), Сот.НайтиПоНаименованию("Волков Игорь", Истина), Стр);
	Стр = Новый Массив; Стр.Добавить(СтрокаДок(ЗамМасла, 1, 1500)); Стр.Добавить(СтрокаДок(М, 1, 3400)); Стр.Добавить(СтрокаДок(Ф, 1, 480));
	СоздатьОказание('20260425', Основной, Кл.НайтиПоНаименованию("Морозова Елена", Истина), Сот.НайтиПоНаименованию("Орлов Виктор", Истина), Стр);
КонецПроцедуры

Процедура Проверка_Лаб2_3(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБЫ 2-3 ===");
	ЗаписатьЛог(Лог, "Документы (дата | номер | вид | проведён | склад):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Ж.Дата, Ж.Номер, ПРЕДСТАВЛЕНИЕ(Ж.Ссылка) КАК Док, Ж.Проведен, Ж.Склад ИЗ ЖурналДокументов.СкладскиеДокументы КАК Ж УПОРЯДОЧИТЬ ПО Ж.Дата"));
	ЗаписатьЛог(Лог, "Записей в регистре ОстаткиМатериалов: " + ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.ОстаткиМатериалов КАК Р"));
	ЗаписатьЛог(Лог, "Остатки (склад | материал | остаток):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ О.Склад.Наименование, О.Материал.Наименование, О.КоличествоОстаток ИЗ РегистрНакопления.ОстаткиМатериалов.Остатки КАК О УПОРЯДОЧИТЬ ПО О.Склад.Наименование, О.Материал.Наименование"));
КонецПроцедуры

Процедура Вызвать(Имя, Лог)
	Попытка
		Выполнить(Имя + "(Лог);");
	Исключение
		ЗаписатьЛог(Лог, "ОШИБКА в " + Имя + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Возвращает Истина, если был выполнен прогон.
Функция Запустить() Экспорт
	Флаг = Новый Файл(КаталогБазы() + "run.flag");
	Если Не Флаг.Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	Лог = Новый Массив;
	ЗаписатьЛог(Лог, "Старт: " + Строка(ТекущаяДата()));
	Вызвать("Заполнить_1_Справочники", Лог);
	Вызвать("Заполнить_2_Документы", Лог);
	Вызвать("Проверка_Лаб2_3", Лог);
	ЗаписатьЛог(Лог, "Конец: " + Строка(ТекущаяДата()));
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(СтрСоединить(Лог, Символы.ПС));
	Текст.Записать(КаталогБазы() + "verify.txt", КодировкаТекста.UTF8);
	УдалитьФайлы(КаталогБазы() + "run.flag");
	Возврат Истина;
КонецФункции
