			Объект.Должность = М.Должность;
			Объект.ДатаПриема = М.Дата;
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;
	НайтиСоздать(Справочники.Склады, "Склад запчастей");
	ГруппаУслуги = НайтиСоздать(Справочники.Номенклатура, "Услуги", Истина);
	ГруппаМатериалы = НайтиСоздать(Справочники.Номенклатура, "Материалы", Истина);
	Для Каждого Имя Из СтрРазделить("Замена масла двигателя,Компьютерная диагностика,Замена тормозных колодок,Шиномонтаж", ",") Цикл
		НайтиСоздать(Справочники.Номенклатура, Имя, Ложь, ГруппаУслуги);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Масло моторное 5W-40,Фильтр масляный,Колодки тормозные (комплект),Антифриз G12 (5 л)", ",") Цикл
		НайтиСоздать(Справочники.Номенклатура, Имя, Ложь, ГруппаМатериалы);
