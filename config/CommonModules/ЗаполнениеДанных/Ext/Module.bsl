// Недостающие данные для демонстрации соединений: 2 клиента без района, 3 района без клиентов
Процедура Заполнить_7_ДанныеДляСоединений(Лог)
	Для Каждого Имя Из СтрРазделить("Новый город,Центральный,Северный", ",") Цикл
		НайтиСоздать(Справочники.Районы, Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Беляев Андрей,Григорьев Павел", ",") Цикл
		Если Справочники.Клиенты.НайтиПоНаименованию(Имя, Истина).Пустая() Тогда
			Объект = Справочники.Клиенты.СоздатьЭлемент();
			Объект.Наименование = Имя;
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура Проверка_Лаб10(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 10 ===");
	ЗаписатьЛог(Лог, "--- Запрос 2 (Пункт 2): Сотрудники с должностями и датой приёма ---");
	ЗаписатьЛог(Лог, ТекстЗапроса(Запрос10_2()));
	ЗаписатьЛог(Лог, "--- Запрос 3 (Пункт 3): Клиенты: код и наименование, сортировка по наименованию ---");
	ЗаписатьЛог(Лог, ТекстЗапроса(Запрос10_3()));
	ЗаписатьЛог(Лог, "--- Запрос 4 (Пункт 4): Приходные накладные с материалами дороже 4000 руб. ---");
	ЗаписатьЛог(Лог, ТекстЗапроса(Запрос10_4()));
	ЗаписатьЛог(Лог, "--- Запрос 5 (Пункт 5): Услуги из всех документов ОказаниеУслуги без повторов (параметр ВидНоменклатуры = Услуга) ---");
	ЗаписатьЛог(Лог, ТекстЗапроса(Запрос10_5(), Новый Структура("ВидНоменклатуры", Перечисления.ВидыНоменклатуры.Услуга)));
	ЗаписатьЛог(Лог, "--- Запрос 7 (Пункт 7): Левое соединение: все клиенты и их районы ---");
	ЗаписатьЛог(Лог, ТекстЗапроса(Запрос10_7()));
	ЗаписатьЛог(Лог, "--- Запрос 8 (Пункт 8): Правое соединение: все районы и их клиенты ---");
	ЗаписатьЛог(Лог, ТекстЗапроса(Запрос10_8()));
	ЗаписатьЛог(Лог, "--- Запрос 9 (Пункт 9): Полное соединение: все клиенты и все районы ---");
	ЗаписатьЛог(Лог, ТекстЗапроса(Запрос10_9()));
	ЗаписатьЛог(Лог, "--- Запрос 10 (Пункт 10): Внутреннее соединение: клиенты с назначенным районом ---");
	ЗаписатьЛог(Лог, ТекстЗапроса(Запрос10_10()));
	ЗаписатьЛог(Лог, "--- Запрос л1 (Лекция 13): ПЕРВЫЕ 2 клиента по наименованию ---");
	ЗаписатьЛог(Лог, ТекстЗапроса(Запрос10_л1()));
	ЗаписатьЛог(Лог, "--- Запрос л2 (Лекция 13): Клиенты из документов ОказаниеУслуги без повторов ---");
	ЗаписатьЛог(Лог, ТекстЗапроса(Запрос10_л2()));
	ЗаписатьЛог(Лог, "--- Запрос л3 (Лекция 13): Номенклатура без групп ---");
	ЗаписатьЛог(Лог, ТекстЗапроса(Запрос10_л3()));
	ЗаписатьЛог(Лог, "--- Запрос л4 (Лекция 13): Число документов ОказаниеУслуги и число различных клиентов ---");
	ЗаписатьЛог(Лог, ТекстЗапроса(Запрос10_л4()));
	// Сверка числа строк соединений с числом клиентов и районов
	Клиентов = КолвоСтрок("ВЫБРАТЬ К.Ссылка ИЗ Справочник.Клиенты КАК К");
	СРайоном = КолвоСтрок("ВЫБРАТЬ К.Ссылка ИЗ Справочник.Клиенты КАК К ГДЕ К.Район <> ЗНАЧЕНИЕ(Справочник.Районы.ПустаяСсылка)");
	БезКлиентов = КолвоСтрок("ВЫБРАТЬ Р.Ссылка ИЗ Справочник.Районы КАК Р ГДЕ НЕ Р.Ссылка В (ВЫБРАТЬ К.Район ИЗ Справочник.Клиенты КАК К)");
	Лев = КолвоСтрок(Запрос10_7()); Прав = КолвоСтрок(Запрос10_8()); Полн = КолвоСтрок(Запрос10_9()); Внутр = КолвоСтрок(Запрос10_10());
	ЗаписатьЛог(Лог, "Клиентов " + Клиентов + ", из них с районом " + СРайоном + ", районов без клиентов " + БезКлиентов);
	ЗаписатьЛог(Лог, "Левое: " + Лев + " (ожидается " + Клиентов + ") | " + ?(Лев = Клиентов, "OK", "!!! расхождение"));
	ЗаписатьЛог(Лог, "Правое: " + Прав + " (ожидается " + (СРайоном + БезКлиентов) + ") | " + ?(Прав = СРайоном + БезКлиентов, "OK", "!!! расхождение"));
	ЗаписатьЛог(Лог, "Полное: " + Полн + " (ожидается " + (Клиентов + БезКлиентов) + ") | " + ?(Полн = Клиентов + БезКлиентов, "OK", "!!! расхождение"));
	ЗаписатьЛог(Лог, "Внутреннее: " + Внутр + " (ожидается " + СРайоном + ") | " + ?(Внутр = СРайоном, "OK", "!!! расхождение"));
	ЗаписатьЛог(Лог, "Клиентов без района (ожидается не менее 2): " + (Клиентов - СРайоном) + " | " + ?(Клиентов - СРайоном >= 2, "OK", "!!! нет клиентов без района"));
	ЗаписатьЛог(Лог, "Районов без клиентов (ожидается не менее 3): " + БезКлиентов + " | " + ?(БезКлиентов >= 3, "OK", "!!! нет районов без клиентов"));
КонецПроцедуры

Процедура Вызвать(Имя, Лог)
	Попытка
		Выполнить(Имя + "(Лог);");
	Исключение
		ЗаписатьЛог(Лог, "ОШИБКА в " + Имя + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Возвращает Истина, если был выполнен прогон.
Функция Запустить() Экспорт
	Флаг = Новый Файл(КаталогБазы() + "run.flag");
	Если Не Флаг.Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	Лог = Новый Массив;
	ЗаписатьЛог(Лог, "Старт: " + Строка(ТекущаяДата()));
	Вызвать("Заполнить_1_Справочники", Лог);
	Вызвать("Заполнить_2_Документы", Лог);
	Вызвать("Заполнить_3_Цены", Лог);
	Вызвать("Заполнить_4_ВидыНоменклатуры", Лог);
	Вызвать("Заполнить_5_СтоимостьМатериалов", Лог);
	Вызвать("Заполнить_6_Продажи", Лог);
	Вызвать("Заполнить_7_ДанныеДляСоединений", Лог);
	Вызвать("Проверка_Лаб2_3", Лог);
	Вызвать("Проверка_Лаб4", Лог);
	Вызвать("Проверка_Лаб5", Лог);
	Вызвать("Проверка_Лаб6", Лог);
	Вызвать("Проверка_Лаб7", Лог);
	Вызвать("Проверка_Лаб8", Лог);
	Вызвать("Проверка_Лаб9", Лог);
	Вызвать("Проверка_Лаб10", Лог);
	ЗаписатьЛог(Лог, "Конец: " + Строка(ТекущаяДата()));
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(СтрСоединить(Лог, Символы.ПС));
	Текст.Записать(КаталогБазы() + "verify.txt", КодировкаТекста.UTF8);
	УдалитьФайлы(КаталогБазы() + "run.flag");
	Возврат Истина;
КонецФункции
