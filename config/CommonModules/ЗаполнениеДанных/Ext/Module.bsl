Процедура Проверка_Лаб9(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 9 ===");
	ЗаписатьЛог(Лог, СравнитьОтчёт("Продажи: записей (по строкам проведённых документов)",
		ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.Продажи КАК Р"),
		ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.ОказаниеУслуги.ПереченьНоменклатуры КАК Т ГДЕ Т.Ссылка.Проведен")));
	ЗаписатьЛог(Лог, СравнитьОтчёт("Продажи: количество",
		ТекстЗапроса("ВЫБРАТЬ СУММА(Р.Количество) ИЗ РегистрНакопления.Продажи КАК Р"),
		ТекстЗапроса("ВЫБРАТЬ СУММА(Т.Количество) ИЗ Документ.ОказаниеУслуги.ПереченьНоменклатуры КАК Т ГДЕ Т.Ссылка.Проведен")));
	ЗаписатьЛог(Лог, СравнитьОтчёт("Продажи: выручка",
		ТекстЗапроса("ВЫБРАТЬ СУММА(Р.Выручка) ИЗ РегистрНакопления.Продажи КАК Р"),
		ТекстЗапроса("ВЫБРАТЬ СУММА(Т.Сумма) ИЗ Документ.ОказаниеУслуги.ПереченьНоменклатуры КАК Т ГДЕ Т.Ссылка.Проведен")));
	ЗаписатьЛог(Лог, СравнитьОтчёт("Продажи: стоимость (равна расходу в СтоимостьМатериалов)",
		ТекстЗапроса("ВЫБРАТЬ СУММА(Р.Стоимость) ИЗ РегистрНакопления.Продажи КАК Р"),
		ТекстЗапроса("ВЫБРАТЬ СУММА(Р.Стоимость) ИЗ РегистрНакопления.СтоимостьМатериалов КАК Р ГДЕ ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(Документ.ОказаниеУслуги)")));
	ЗаписатьЛог(Лог, "Продажи (период | номенклатура | клиент | мастер | кол-во | выручка | стоимость):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Р.Период, Р.Номенклатура.Наименование, Р.Клиент.Наименование, Р.Мастер.Наименование, Р.Количество, Р.Выручка, Р.Стоимость ИЗ РегистрНакопления.Продажи КАК Р УПОРЯДОЧИТЬ ПО Р.Период, Р.НомерСтроки"));
	// Отчёт: весь период и март
	Все = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.ОказаниеУслуги КАК Д ГДЕ Д.Дата МЕЖДУ &ДатаНач И &ДатаКон", Новый Структура("ДатаНач,ДатаКон", '20260301', '20260430235959'));
	Март = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.ОказаниеУслуги КАК Д ГДЕ Д.Дата МЕЖДУ &ДатаНач И &ДатаКон", Новый Структура("ДатаНач,ДатаКон", '20260301', '20260331235959'));
