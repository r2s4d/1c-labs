Процедура Проверка_Лаб2_3(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБЫ 2-3 ===");
	ЗаписатьЛог(Лог, "Документы (дата | номер | вид | проведён | склад):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Ж.Дата, Ж.Номер, ПРЕДСТАВЛЕНИЕ(Ж.Ссылка) КАК Док, Ж.Проведен, Ж.Склад ИЗ ЖурналДокументов.СкладскиеДокументы КАК Ж УПОРЯДОЧИТЬ ПО Ж.Дата"));
	ЗаписатьЛог(Лог, "Записей в регистре ОстаткиМатериалов: " + ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.ОстаткиМатериалов КАК Р"));
	ЗаписатьЛог(Лог, "Остатки (склад | материал | остаток):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ О.Склад.Наименование, О.Материал.Наименование, О.КоличествоОстаток ИЗ РегистрНакопления.ОстаткиМатериалов.Остатки КАК О УПОРЯДОЧИТЬ ПО О.Склад.Наименование, О.Материал.Наименование"));
КонецПроцедуры

//// ЛАБА 4: простые отчёты
