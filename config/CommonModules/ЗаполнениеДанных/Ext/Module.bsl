	// Универсальный
	ЗаписатьЛог(Лог, "--- Универсальный: выполнение без ошибки: " + ТекстОтчета("Универсальный") + "OK ---");
КонецПроцедуры

//// ЛАБА 14: оптимизация проведения ОказаниеУслуги, стоимость по среднему
Процедура Проверка_Лаб14(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 14 ===");
	// Каждый документ перепроводится новым алгоритмом: движения по трём регистрам совпадают по строкам-материалам
	ЗаписатьЛог(Лог, СравнитьОтчёт("Расход ОстаткиМатериалов: записей",
		ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.ОстаткиМатериалов КАК Р ГДЕ ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(Документ.ОказаниеУслуги)"),
		ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.ОказаниеУслуги.ПереченьНоменклатуры КАК Т ГДЕ Т.Ссылка.Проведен И Т.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материал)")));
	ЗаписатьЛог(Лог, СравнитьОтчёт("Продажи: стоимость равна расходу в СтоимостьМатериалов",
		ТекстЗапроса("ВЫБРАТЬ СУММА(Р.Стоимость) ИЗ РегистрНакопления.Продажи КАК Р"),
		ТекстЗапроса("ВЫБРАТЬ СУММА(Р.Стоимость) ИЗ РегистрНакопления.СтоимостьМатериалов КАК Р ГДЕ ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(Документ.ОказаниеУслуги)")));
	ЗаписатьЛог(Лог, "Движения СтоимостьМатериалов расход по документам оказания (дата | материал | стоимость):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Р.Период, Р.Материал.Наименование, Р.Стоимость ИЗ РегистрНакопления.СтоимостьМатериалов КАК Р ГДЕ ТИПЗНАЧЕНИЯ(Р.Регистратор) = ТИП(Документ.ОказаниеУслуги) УПОРЯДОЧИТЬ ПО Р.Период"));
	ЗаписатьЛог(Лог, "Средняя стоимость единицы после проведения (материал | остаток количество | остаток стоимость | на единицу):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ К.Материал.Наименование КАК Материал, К.КоличествоОстаток КАК Колво, С.СтоимостьОстаток КАК Стоимость, ВЫБОР КОГДА К.КоличествоОстаток = 0 ТОГДА 0 ИНАЧЕ С.СтоимостьОстаток / К.КоличествоОстаток КОНЕЦ КАК НаЕдиницу " +
		"ИЗ (ВЫБРАТЬ О.Материал КАК Материал, СУММА(О.КоличествоОстаток) КАК КоличествоОстаток ИЗ РегистрНакопления.ОстаткиМатериалов.Остатки КАК О СГРУППИРОВАТЬ ПО О.Материал) КАК К " +
		"ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьМатериалов.Остатки КАК С ПО К.Материал = С.Материал УПОРЯДОЧИТЬ ПО Материал"));
	Отриц = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.СтоимостьМатериалов.Остатки КАК С ГДЕ С.СтоимостьОстаток < 0");
	ЗаписатьЛог(Лог, "Отрицательных остатков по стоимости (ожидается 0): " + Отриц + " | " + ?(Отриц = "0", "OK", "!!! отрицательная стоимость остатка"));
КонецПроцедуры

//// ЛАБА 15: контроль остатков при оперативном проведении
Процедура Заполнить_8_ОперативныйДокумент(Лог)
	// Один документ сегодняшним числом, проведённый оперативно (для демонстрации и отчётов с периодом «этот месяц»)
	Начало = НачалоДня(ТекущаяДата());
	Если Документы.ОказаниеУслуги.Выбрать(Начало, КонецДня(ТекущаяДата())).Следующий() Тогда
		Возврат;
	КонецЕсли;
	Док = Документы.ОказаниеУслуги.СоздатьДокумент();
	Док.Дата = ТекущаяДата();
	Док.Склад = Справочники.Склады.Основной;
	Док.Клиент = Справочники.Клиенты.НайтиПоНаименованию("Иванов Сергей", Истина);
	Док.Мастер = Справочники.Сотрудники.НайтиПоНаименованию("Орлов Виктор", Истина);
	Н = Док.ПереченьНоменклатуры.Добавить();
	Н.Номенклатура = НомК("Замена масла двигателя");
	Н.Количество = 1;
	Н.Цена = РаботаСоСправочниками.РозничнаяЦена(Док.Дата, Н.Номенклатура);
	Н.Сумма = Н.Количество * Н.Цена;
	Н = Док.ПереченьНоменклатуры.Добавить();
	Н.Номенклатура = НомК("Фильтр масляный");
	Н.Количество = 1;
	Н.Цена = РаботаСоСправочниками.РозничнаяЦена(Док.Дата, Н.Номенклатура);
	Н.Сумма = Н.Количество * Н.Цена;
	Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);
КонецПроцедуры

Процедура Проверка_Лаб15(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 15 ===");
	// 1. Оперативное проведение с нехваткой материала должно быть отклонено
	Док = Документы.ОказаниеУслуги.СоздатьДокумент();
	Док.Дата = ТекущаяДата();
	Док.Склад = Справочники.Склады.Основной;
	Док.Клиент = Справочники.Клиенты.НайтиПоНаименованию("Иванов Сергей", Истина);
	Док.Мастер = Справочники.Сотрудники.НайтиПоНаименованию("Орлов Виктор", Истина);
	Н = Док.ПереченьНоменклатуры.Добавить();
	Н.Номенклатура = НомК("Масло моторное 5W-40");
	Н.Количество = 100000;
	Н.Цена = РаботаСоСправочниками.РозничнаяЦена(Док.Дата, Н.Номенклатура);
	Н.Сумма = Н.Количество * Н.Цена;
	Проведён = Ложь;
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);
		Проведён = Док.Проведен;
	Исключение
		ЗаписатьЛог(Лог, "Проведение отклонено (ожидаемо): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Для Каждого Сообщ Из ПолучитьСообщенияПользователю(Истина) Цикл
		ЗаписатьЛог(Лог, "Сообщение: " + Сообщ.Текст);
	КонецЦикла;
	ЗаписатьЛог(Лог, "Документ с нехваткой материала НЕ проведён: " + ?(Не Проведён, "OK", "!!! документ проведён вопреки контролю остатков"));
	// 2. Документ прошлым числом проводится неоперативно и без контроля: проверяем режим по дате
	ЗаписатьЛог(Лог, "Оперативный документ сегодняшней датой (заполнен кодом): " + ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.ОказаниеУслуги КАК Д ГДЕ Д.Дата МЕЖДУ &Н И &К И Д.Проведен", Новый Структура("Н,К", НачалоДня(ТекущаяДата()), КонецДня(ТекущаяДата()))));
	// 3. Остатки не ушли в минус
	Отриц = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.ОстаткиМатериалов.Остатки КАК О ГДЕ О.КоличествоОстаток < 0");
	ЗаписатьЛог(Лог, "Отрицательных остатков материалов (ожидается 0): " + Отриц + " | " + ?(Отриц = "0", "OK", "!!! есть отрицательные остатки"));
КонецПроцедуры

//// ЛАБА 16: роли, пользователи, проверка прав
// Создание пользователей ИБ. НЕ вызывается автоматически: после создания пользователей запуск клиента требует выбора пользователя.
// Запускается, если рядом с базой лежит файл users.flag (см. Запустить()).
Процедура СоздатьПользователейЛабы(Лог)
	Список = Новый Массив;
	Список.Добавить(Новый Структура("Имя,ПолноеИмя,Роль", "Администратор", "Администратор системы", "Администратор"));
	Список.Добавить(Новый Структура("Имя,ПолноеИмя,Роль", "Петров", "Петров Иван Сергеевич", "Директор"));
	Список.Добавить(Новый Структура("Имя,ПолноеИмя,Роль", "Орлов", "Орлов Виктор Андреевич", "Мастер"));
	Список.Добавить(Новый Структура("Имя,ПолноеИмя,Роль", "Волков", "Волков Игорь Николаевич", "Мастер"));
	Список.Добавить(Новый Структура("Имя,ПолноеИмя,Роль", "Сидорова", "Сидорова Елена Петровна", "Бухгалтер"));
	Для Каждого П Из Список Цикл
		Если ПользователиИнформационнойБазы.НайтиПоИмени(П.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Польз = ПользователиИнформационнойБазы.СоздатьПользователя();
		Польз.Имя = П.Имя;
		Польз.ПолноеИмя = П.ПолноеИмя;
		Польз.АутентификацияСтандартная = Истина;
		Польз.ПоказыватьВСпискеВыбора = Истина;
		Польз.Язык = Метаданные.Языки.Русский;
		Польз.Роли.Добавить(Метаданные.Роли[П.Роль]);
		Польз.Записать();
		ЗаписатьЛог(Лог, "Создан пользователь " + П.Имя + " (" + П.Роль + ")");
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьПраво(Лог, Польз, Подпись, Право, ОбъектМД, Ожидается)
	Факт = ПравоДоступа(Право, ОбъектМД, Польз);
	ЗаписатьЛог(Лог, Подпись + ": " + Право + " = " + Строка(Факт) + " | " + ?(Факт = Ожидается, "OK", "!!! ожидалось " + Строка(Ожидается)));
КонецПроцедуры

Функция ПользовательСРолью(Роль)
	// Несохранённый пользователь: права вычисляются по его ролям, в базе пользователей не создаётся
	Польз = ПользователиИнформационнойБазы.СоздатьПользователя();
	Польз.Роли.Добавить(Метаданные.Роли[Роль]);
	Возврат Польз;
КонецФункции

Процедура Проверка_Лаб16(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 16 ===");
	Док = Метаданные.Документы; Спр = Метаданные.Справочники; Подс = Метаданные.Подсистемы;
	Польз = ПользовательСРолью("Администратор");
	ЗаписатьЛог(Лог, "--- Роль Администратор ---");
	ПроверитьПраво(Лог, Польз, "ПриходнаяНакладная", "Изменение", Док.ПриходнаяНакладная, Истина);
	ПроверитьПраво(Лог, Польз, "Клиенты", "Удаление", Спр.Клиенты, Истина);
	ПроверитьПраво(Лог, Польз, "Клиенты (интерактивное удаление отключено)", "ИнтерактивноеУдаление", Спр.Клиенты, Ложь);
	Польз = ПользовательСРолью("Директор");
	ЗаписатьЛог(Лог, "--- Роль Директор ---");
	ПроверитьПраво(Лог, Польз, "ОказаниеУслуги", "Просмотр", Док.ОказаниеУслуги, Истина);
	ПроверитьПраво(Лог, Польз, "ОказаниеУслуги", "Изменение", Док.ОказаниеУслуги, Ложь);
	ПроверитьПраво(Лог, Польз, "Клиенты", "Добавление", Спр.Клиенты, Ложь);
	ПроверитьПраво(Лог, Польз, "Подсистема РасчетЗарплаты", "Просмотр", Подс.РасчетЗарплаты, Истина);
	Польз = ПользовательСРолью("Мастер");
	ЗаписатьЛог(Лог, "--- Роль Мастер ---");
	ПроверитьПраво(Лог, Польз, "ОказаниеУслуги", "Добавление", Док.ОказаниеУслуги, Истина);
	ПроверитьПраво(Лог, Польз, "Номенклатура", "Изменение", Спр.Номенклатура, Ложь);
	ПроверитьПраво(Лог, Польз, "Номенклатура", "Просмотр", Спр.Номенклатура, Истина);
	ПроверитьПраво(Лог, Польз, "Клиенты", "Добавление", Спр.Клиенты, Истина);
	ПроверитьПраво(Лог, Польз, "Регистр Цены", "Изменение", Метаданные.РегистрыСведений.Цены, Ложь);
	ПроверитьПраво(Лог, Польз, "ПриходнаяНакладная", "Изменение", Док.ПриходнаяНакладная, Ложь);
	ПроверитьПраво(Лог, Польз, "Подсистема УчетМатериалов", "Просмотр", Подс.УчетМатериалов, Ложь);
	ПроверитьПраво(Лог, Польз, "Подсистема Предприятие", "Просмотр", Подс.Предприятие, Истина);
	ПроверитьПраво(Лог, Польз, "Отчёт РейтингУслуг", "Использование", Метаданные.Отчеты.РейтингУслуг, Истина);
	Польз = ПользовательСРолью("Бухгалтер");
	ЗаписатьЛог(Лог, "--- Роль Бухгалтер ---");
	ПроверитьПраво(Лог, Польз, "ПриходнаяНакладная", "Добавление", Док.ПриходнаяНакладная, Истина);
	ПроверитьПраво(Лог, Польз, "ОказаниеУслуги", "Чтение", Док.ОказаниеУслуги, Истина);
	ПроверитьПраво(Лог, Польз, "ОказаниеУслуги", "Изменение", Док.ОказаниеУслуги, Ложь);
	ПроверитьПраво(Лог, Польз, "Номенклатура", "Изменение", Спр.Номенклатура, Истина);
	ПроверитьПраво(Лог, Польз, "Подсистема РасчетЗарплаты", "Просмотр", Подс.РасчетЗарплаты, Истина);
	ЗаписатьЛог(Лог, "Пользователи информационной базы (если пусто, создать: положить users.flag рядом с базой и запустить проверку): " + ПользователиИнформационнойБазы.ПолучитьПользователей().Количество());
КонецПроцедуры

Процедура Вызвать(Имя, Лог)
	Попытка
		Выполнить(Имя + "(Лог);");
	Исключение
		ЗаписатьЛог(Лог, "ОШИБКА в " + Имя + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Возвращает Истина, если был выполнен прогон.
Функция Запустить() Экспорт
	Флаг = Новый Файл(КаталогБазы() + "run.flag");
	Если Не Флаг.Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	Лог = Новый Массив;
	ЗаписатьЛог(Лог, "Старт: " + Строка(ТекущаяДата()));
	Вызвать("Заполнить_1_Справочники", Лог);
	Вызвать("Заполнить_2_Документы", Лог);
	Вызвать("Заполнить_3_Цены", Лог);
	Вызвать("Заполнить_4_ВидыНоменклатуры", Лог);
	Вызвать("Заполнить_5_СтоимостьМатериалов", Лог);
	Вызвать("Заполнить_6_Продажи", Лог);
	Вызвать("Заполнить_7_ДанныеДляСоединений", Лог);
	Вызвать("Заполнить_8_ОперативныйДокумент", Лог);
	Вызвать("Проверка_Лаб2_3", Лог);
	Вызвать("Проверка_Лаб4", Лог);
	Вызвать("Проверка_Лаб5", Лог);
	Вызвать("Проверка_Лаб6", Лог);
	Вызвать("Проверка_Лаб7", Лог);
	Вызвать("Проверка_Лаб8", Лог);
	Вызвать("Проверка_Лаб9", Лог);
	Вызвать("Проверка_Лаб10", Лог);
	Вызвать("Проверка_Лаб11", Лог);
	Вызвать("Проверка_Лаб12", Лог);
	Вызвать("Проверка_Лаб13", Лог);
	Вызвать("Проверка_Лаб14", Лог);
	Вызвать("Проверка_Лаб15", Лог);
	Вызвать("Проверка_Лаб16", Лог);
	Если Новый Файл(КаталогБазы() + "users.flag").Существует() Тогда
		Вызвать("СоздатьПользователейЛабы", Лог);
		УдалитьФайлы(КаталогБазы() + "users.flag");
	КонецЕсли;
	ЗаписатьЛог(Лог, "Конец: " + Строка(ТекущаяДата()));
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(СтрСоединить(Лог, Символы.ПС));
	Текст.Записать(КаталогБазы() + "verify.txt", КодировкаТекста.UTF8);
	УдалитьФайлы(КаталогБазы() + "run.flag");
	Возврат Истина;
КонецФункции
