//// ЛАБА 10: запросы (тексты сгенерированы из batch8.py, они же в docs/lab-10.md)
Функция Запрос10_2()
	Возврат
		"ВЫБРАТЬ
		|	Сотрудники.Наименование КАК ФИО,
		|	Сотрудники.Должность КАК Должность,
		|	Сотрудники.ДатаПриема КАК ДатаПриема
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФИО";
КонецФункции

Функция Запрос10_3()
	Возврат
		"ВЫБРАТЬ
		|	Клиенты.Код КАК Код,
		|	Клиенты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Клиенты КАК Клиенты
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
КонецФункции

Функция Запрос10_4()
	Возврат
		"ВЫБРАТЬ
		|	ПриходнаяНакладнаяМатериалы.Ссылка.Дата КАК Дата,
		|	ПриходнаяНакладнаяМатериалы.Ссылка.Номер КАК Номер,
		|	ПриходнаяНакладнаяМатериалы.Материал.Наименование КАК Материал,
		|	ПриходнаяНакладнаяМатериалы.Цена КАК Цена,
		|	ПриходнаяНакладнаяМатериалы.Количество КАК Количество,
		|	ПриходнаяНакладнаяМатериалы.Сумма КАК Сумма
		|ИЗ
		|	Документ.ПриходнаяНакладная.Материалы КАК ПриходнаяНакладнаяМатериалы
		|ГДЕ
		|	ПриходнаяНакладнаяМатериалы.Цена > 4000
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номер";
КонецФункции

Функция Запрос10_5()
	Возврат
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОказаниеУслугиПереченьНоменклатуры.Номенклатура КАК Услуга
		|ИЗ
		|	Документ.ОказаниеУслуги.ПереченьНоменклатуры КАК ОказаниеУслугиПереченьНоменклатуры
		|ГДЕ
		|	ОказаниеУслугиПереченьНоменклатуры.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры";
КонецФункции

