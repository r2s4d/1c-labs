//// ЛАБА 5: макеты и печатные формы
Процедура Проверка_Лаб5(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 5 ===");
	Для Каждого Имя Из Новый Структура("ОказаниеУслуги,ПриходнаяНакладная") Цикл
		Выборка = Документы[Имя.Ключ].Выбрать();
		Если Выборка.Следующий() Тогда
			Масс = Новый Массив;
			Масс.Добавить(Выборка.Ссылка);
			ТабДок = Новый ТабличныйДокумент;
			Документы[Имя.Ключ].Печать(ТабДок, Масс, Неопределено, "Печать");
			ЗаписатьЛог(Лог, "--- Печать " + Имя.Ключ + " " + Выборка.Номер + " ---");
			Для Стр = 1 По ТабДок.ВысотаТаблицы Цикл
				Части = Новый Массив;
				Для Кол = 1 По ТабДок.ШиринаТаблицы Цикл
					Т = СокрЛП(ТабДок.Область(Стр, Кол, Стр, Кол).Текст);
					Если Т <> "" Тогда
						Части.Добавить(Т);
					КонецЕсли;
				КонецЦикла;
				ЗаписатьЛог(Лог, СтрСоединить(Части, " | "));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
