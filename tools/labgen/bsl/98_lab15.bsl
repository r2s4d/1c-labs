//// ЛАБА 15: контроль остатков при оперативном проведении
Процедура Заполнить_8_ОперативныйДокумент(Лог)
	// Один документ сегодняшним числом, проведённый оперативно (для демонстрации и отчётов с периодом «этот месяц»)
	Начало = НачалоДня(ТекущаяДата());
	Если Документы.ОказаниеУслуги.Выбрать(Начало, КонецДня(ТекущаяДата())).Следующий() Тогда
		Возврат;
	КонецЕсли;
	Док = Документы.ОказаниеУслуги.СоздатьДокумент();
	Док.Дата = ТекущаяДата();
	Док.Склад = Справочники.Склады.Основной;
	Док.Клиент = Справочники.Клиенты.НайтиПоНаименованию("Иванов Сергей", Истина);
	Док.Мастер = Справочники.Сотрудники.НайтиПоНаименованию("Орлов Виктор", Истина);
	Н = Док.ПереченьНоменклатуры.Добавить();
	Н.Номенклатура = НомК("Замена масла двигателя");
	Н.Количество = 1;
	Н.Цена = РаботаСоСправочниками.РозничнаяЦена(Док.Дата, Н.Номенклатура);
	Н.Сумма = Н.Количество * Н.Цена;
	Н = Док.ПереченьНоменклатуры.Добавить();
	Н.Номенклатура = НомК("Фильтр масляный");
	Н.Количество = 1;
	Н.Цена = РаботаСоСправочниками.РозничнаяЦена(Док.Дата, Н.Номенклатура);
	Н.Сумма = Н.Количество * Н.Цена;
	Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);
КонецПроцедуры

Процедура Проверка_Лаб15(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 15 ===");
	// 1. Оперативное проведение с нехваткой материала должно быть отклонено
	Док = Документы.ОказаниеУслуги.СоздатьДокумент();
	Док.Дата = ТекущаяДата();
	Док.Склад = Справочники.Склады.Основной;
	Док.Клиент = Справочники.Клиенты.НайтиПоНаименованию("Иванов Сергей", Истина);
	Док.Мастер = Справочники.Сотрудники.НайтиПоНаименованию("Орлов Виктор", Истина);
	Н = Док.ПереченьНоменклатуры.Добавить();
	Н.Номенклатура = НомК("Масло моторное 5W-40");
	Н.Количество = 100000;
	Н.Цена = РаботаСоСправочниками.РозничнаяЦена(Док.Дата, Н.Номенклатура);
	Н.Сумма = Н.Количество * Н.Цена;
	Проведён = Ложь;
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);
		Проведён = Док.Проведен;
	Исключение
		ЗаписатьЛог(Лог, "Проведение отклонено (ожидаемо): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Для Каждого Сообщ Из ПолучитьСообщенияПользователю(Истина) Цикл
		ЗаписатьЛог(Лог, "Сообщение: " + Сообщ.Текст);
	КонецЦикла;
	ЗаписатьЛог(Лог, "Документ с нехваткой материала НЕ проведён: " + ?(Не Проведён, "OK", "!!! документ проведён вопреки контролю остатков"));
	// 2. Документ прошлым числом проводится неоперативно и без контроля: проверяем режим по дате
	ЗаписатьЛог(Лог, "Оперативный документ сегодняшней датой (заполнен кодом): " + ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ Документ.ОказаниеУслуги КАК Д ГДЕ Д.Дата МЕЖДУ &Н И &К И Д.Проведен", Новый Структура("Н,К", НачалоДня(ТекущаяДата()), КонецДня(ТекущаяДата()))));
	// 3. Остатки не ушли в минус
	Отриц = ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрНакопления.ОстаткиМатериалов.Остатки КАК О ГДЕ О.КоличествоОстаток < 0");
	ЗаписатьЛог(Лог, "Отрицательных остатков материалов (ожидается 0): " + Отриц + " | " + ?(Отриц = "0", "OK", "!!! есть отрицательные остатки"));
КонецПроцедуры
