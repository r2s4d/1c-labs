//// Вспомогательное: выполнение отчёта на СКД и вывод результата текстом
Функция ТекстОтчета(ИмяОтчета, Параметры = Неопределено, ИмяМакета = "ОсновнаяСхемаКомпоновкиДанных", ВариантНастроек = Неопределено)
	Схема = Отчеты[ИмяОтчета].ПолучитьМакет(ИмяМакета);
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Если ВариантНастроек = Неопределено Тогда
		Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Иначе
		Компоновщик.ЗагрузитьНастройки(Схема.ВариантыНастроек[ВариантНастроек].Настройки);
	КонецЕсли;
	Если Параметры <> Неопределено Тогда
		Для Каждого П Из Параметры Цикл
			Параметр = Компоновщик.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(П.Ключ));
			Если Параметр <> Неопределено Тогда
				Параметр.Использование = Истина;
				Параметр.Значение = П.Значение;
			Иначе
				Возврат "!!! параметр не найден: " + П.Ключ;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Компоновщик.ПолучитьНастройки(), , , Тип("ГенераторМакетаКомпоновкиДанных"));
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);
	Документ = Новый ТабличныйДокумент;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	Вывод.УстановитьДокумент(Документ);
	Вывод.Вывести(Процессор);
	Строки = Новый Массив;
	Для Стр = 1 По Документ.ВысотаТаблицы Цикл
		Части = Новый Массив;
		Для Кол = 1 По Документ.ШиринаТаблицы Цикл
			Текст = СокрЛП(Документ.Область(Стр, Кол, Стр, Кол).Текст);
			Если Текст <> "" Тогда
				Части.Добавить(Текст);
			КонецЕсли;
		КонецЦикла;
		Если Части.Количество() > 0 Тогда
			Строки.Добавить(СтрСоединить(Части, " | "));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

