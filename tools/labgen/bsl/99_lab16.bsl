//// ЛАБА 16: роли, пользователи, проверка прав
// Создание пользователей ИБ. НЕ вызывается автоматически: после создания пользователей запуск клиента требует выбора пользователя.
// Запускается, если рядом с базой лежит файл users.flag (см. Запустить()).
Процедура СоздатьПользователейЛабы(Лог)
	Список = Новый Массив;
	Список.Добавить(Новый Структура("Имя,ПолноеИмя,Роль", "Администратор", "Администратор системы", "Администратор"));
	Список.Добавить(Новый Структура("Имя,ПолноеИмя,Роль", "Петров", "Петров Иван Сергеевич", "Директор"));
	Список.Добавить(Новый Структура("Имя,ПолноеИмя,Роль", "Орлов", "Орлов Виктор Андреевич", "Мастер"));
	Список.Добавить(Новый Структура("Имя,ПолноеИмя,Роль", "Волков", "Волков Игорь Николаевич", "Мастер"));
	Список.Добавить(Новый Структура("Имя,ПолноеИмя,Роль", "Сидорова", "Сидорова Елена Петровна", "Бухгалтер"));
	Для Каждого П Из Список Цикл
		Если ПользователиИнформационнойБазы.НайтиПоИмени(П.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Польз = ПользователиИнформационнойБазы.СоздатьПользователя();
		Польз.Имя = П.Имя;
		Польз.ПолноеИмя = П.ПолноеИмя;
		Польз.АутентификацияСтандартная = Истина;
		Польз.ПоказыватьВСпискеВыбора = Истина;
		Польз.Язык = Метаданные.Языки.Русский;
		Польз.Роли.Добавить(Метаданные.Роли[П.Роль]);
		Польз.Записать();
		ЗаписатьЛог(Лог, "Создан пользователь " + П.Имя + " (" + П.Роль + ")");
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьПраво(Лог, Польз, Подпись, Право, ОбъектМД, Ожидается)
	Факт = ПравоДоступа(Право, ОбъектМД, Польз);
	ЗаписатьЛог(Лог, Подпись + ": " + Право + " = " + Строка(Факт) + " | " + ?(Факт = Ожидается, "OK", "!!! ожидалось " + Строка(Ожидается)));
КонецПроцедуры

Функция ПользовательСРолью(Роль)
	// Несохранённый пользователь: права вычисляются по его ролям, в базе пользователей не создаётся
	Польз = ПользователиИнформационнойБазы.СоздатьПользователя();
	Польз.Роли.Добавить(Метаданные.Роли[Роль]);
	Возврат Польз;
КонецФункции

Процедура Проверка_Лаб16(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 16 ===");
	Док = Метаданные.Документы; Спр = Метаданные.Справочники; Подс = Метаданные.Подсистемы;
	Польз = ПользовательСРолью("Администратор");
	ЗаписатьЛог(Лог, "--- Роль Администратор ---");
	ПроверитьПраво(Лог, Польз, "ПриходнаяНакладная", "Изменение", Док.ПриходнаяНакладная, Истина);
	ПроверитьПраво(Лог, Польз, "Клиенты", "Удаление", Спр.Клиенты, Истина);
	ПроверитьПраво(Лог, Польз, "Клиенты (интерактивное удаление отключено)", "ИнтерактивноеУдаление", Спр.Клиенты, Ложь);
	Польз = ПользовательСРолью("Директор");
	ЗаписатьЛог(Лог, "--- Роль Директор ---");
	ПроверитьПраво(Лог, Польз, "ОказаниеУслуги", "Просмотр", Док.ОказаниеУслуги, Истина);
	ПроверитьПраво(Лог, Польз, "ОказаниеУслуги", "Изменение", Док.ОказаниеУслуги, Ложь);
	ПроверитьПраво(Лог, Польз, "Клиенты", "Добавление", Спр.Клиенты, Ложь);
	ПроверитьПраво(Лог, Польз, "Подсистема РасчетЗарплаты", "Просмотр", Подс.РасчетЗарплаты, Истина);
	Польз = ПользовательСРолью("Мастер");
	ЗаписатьЛог(Лог, "--- Роль Мастер ---");
	ПроверитьПраво(Лог, Польз, "ОказаниеУслуги", "Добавление", Док.ОказаниеУслуги, Истина);
	ПроверитьПраво(Лог, Польз, "Номенклатура", "Изменение", Спр.Номенклатура, Ложь);
	ПроверитьПраво(Лог, Польз, "Номенклатура", "Просмотр", Спр.Номенклатура, Истина);
	ПроверитьПраво(Лог, Польз, "Клиенты", "Добавление", Спр.Клиенты, Истина);
	ПроверитьПраво(Лог, Польз, "Регистр Цены", "Изменение", Метаданные.РегистрыСведений.Цены, Ложь);
	ПроверитьПраво(Лог, Польз, "ПриходнаяНакладная", "Изменение", Док.ПриходнаяНакладная, Ложь);
	ПроверитьПраво(Лог, Польз, "Подсистема УчетМатериалов", "Просмотр", Подс.УчетМатериалов, Ложь);
	ПроверитьПраво(Лог, Польз, "Подсистема Предприятие", "Просмотр", Подс.Предприятие, Истина);
	ПроверитьПраво(Лог, Польз, "Отчёт РейтингУслуг", "Использование", Метаданные.Отчеты.РейтингУслуг, Истина);
	Польз = ПользовательСРолью("Бухгалтер");
	ЗаписатьЛог(Лог, "--- Роль Бухгалтер ---");
	ПроверитьПраво(Лог, Польз, "ПриходнаяНакладная", "Добавление", Док.ПриходнаяНакладная, Истина);
	ПроверитьПраво(Лог, Польз, "ОказаниеУслуги", "Чтение", Док.ОказаниеУслуги, Истина);
	ПроверитьПраво(Лог, Польз, "ОказаниеУслуги", "Изменение", Док.ОказаниеУслуги, Ложь);
	ПроверитьПраво(Лог, Польз, "Номенклатура", "Изменение", Спр.Номенклатура, Истина);
	ПроверитьПраво(Лог, Польз, "Подсистема РасчетЗарплаты", "Просмотр", Подс.РасчетЗарплаты, Истина);
	ЗаписатьЛог(Лог, "Пользователи информационной базы (если пусто, создать: положить users.flag рядом с базой и запустить проверку): " + ПользователиИнформационнойБазы.ПолучитьПользователей().Количество());
КонецПроцедуры
