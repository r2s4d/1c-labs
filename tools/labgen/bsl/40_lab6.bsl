//// ЛАБА 6: регистр сведений Цены, подстановка цены по дате документа
Процедура УстановитьЦену(Номенклатура, Период, Цена)
	МЗ = РегистрыСведений.Цены.СоздатьМенеджерЗаписи();
	МЗ.Период = Период;
	МЗ.Номенклатура = Номенклатура;
	МЗ.Прочитать();
	Если МЗ.Выбран() Тогда
		Возврат;
	КонецЕсли;
	МЗ.Период = Период;
	МЗ.Номенклатура = Номенклатура;
	МЗ.Цена = Цена;
	МЗ.Записать();
КонецПроцедуры

Функция ТаблицаЦен()
	Т = Новый Массив;
	// Услуги
	Т.Добавить(Новый Структура("Имя,Март,Апрель", "Замена масла двигателя", 1500, 1600));
	Т.Добавить(Новый Структура("Имя,Март,Апрель", "Компьютерная диагностика", 2000, 2200));
	Т.Добавить(Новый Структура("Имя,Март,Апрель", "Замена тормозных колодок", 3000, 3300));
	Т.Добавить(Новый Структура("Имя,Март,Апрель", "Шиномонтаж", 2400, 2600));
	// Материалы
	Т.Добавить(Новый Структура("Имя,Март,Апрель", "Масло моторное 5W-40", 3200, 3400));
	Т.Добавить(Новый Структура("Имя,Март,Апрель", "Фильтр масляный", 450, 480));
	Т.Добавить(Новый Структура("Имя,Март,Апрель", "Колодки тормозные (комплект)", 4800, 5000));
	Т.Добавить(Новый Структура("Имя,Март,Апрель", "Антифриз G12 (5 л)", 1500, 1600));
	Возврат Т;
КонецФункции

Процедура Заполнить_3_Цены(Лог)
	Для Каждого С Из ТаблицаЦен() Цикл
		Н = НомК(С.Имя);
		УстановитьЦену(Н, '20260301', С.Март);
		УстановитьЦену(Н, '20260401', С.Апрель);
	КонецЦикла;
КонецПроцедуры

Процедура Проверка_Лаб6(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 6 ===");
	ЗаписатьЛог(Лог, "Записей в регистре Цены (ожидается 16): " + ТекстЗапроса("ВЫБРАТЬ КОЛИЧЕСТВО(*) ИЗ РегистрСведений.Цены КАК Р"));
	ЗаписатьЛог(Лог, "Цены (номенклатура | период | цена):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Р.Номенклатура.Наименование, Р.Период, Р.Цена ИЗ РегистрСведений.Цены КАК Р УПОРЯДОЧИТЬ ПО Р.Номенклатура.Наименование, Р.Период"));
	ЗаписатьЛог(Лог, "Проверка функции РозничнаяЦена (номенклатура | на 15.03 | на 15.04 | вывод):");
	Для Каждого С Из ТаблицаЦен() Цикл
		Н = НомК(С.Имя);
		ЦенаМарт = РаботаСоСправочниками.РозничнаяЦена('20260315', Н);
		ЦенаАпрель = РаботаСоСправочниками.РозничнаяЦена('20260415', Н);
		Итог = ?(ЦенаМарт = С.Март И ЦенаАпрель = С.Апрель, "OK", "!!! ожидалось " + Строка(С.Март) + " / " + Строка(С.Апрель));
		ЗаписатьЛог(Лог, С.Имя + " | " + Строка(ЦенаМарт) + " | " + Строка(ЦенаАпрель) + " | " + Итог);
	КонецЦикла;
	// Дата раньше первой цены: цены ещё нет, функция должна вернуть 0
	ЦенаДо = РаботаСоСправочниками.РозничнаяЦена('20260101', НомК("Шиномонтаж"));
	ЗаписатьЛог(Лог, "Цена Шиномонтажа на 01.01.2026 (до первой записи, ожидается 0): " + ЦенаДо + " | " + ?(ЦенаДо = 0, "OK", "!!! ожидался 0"));
КонецПроцедуры
