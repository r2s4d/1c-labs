//// ЛАБА 13: ЦеныНаУслуги, РейтингКлиентов, Универсальный
Процедура Проверка_Лаб13(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 13 ===");
	// ЦеныНаУслуги: актуальные цены на дату
	ЗаписатьЛог(Лог, "--- ЦеныНаУслуги на 15.03.2026 (ожидаются мартовские цены: 1500/2000/3000/2400) ---");
	ЗаписатьЛог(Лог, ТекстОтчета("ЦеныНаУслуги", Новый Структура("ДатаОтчета", '20260315')));
	ЗаписатьЛог(Лог, "--- ЦеныНаУслуги на 15.04.2026 (ожидаются апрельские цены: 1600/2200/3300/2600) ---");
	ЗаписатьЛог(Лог, ТекстОтчета("ЦеныНаУслуги", Новый Структура("ДатаОтчета", '20260415')));
	ЗаписатьЛог(Лог, "--- ЦеныНаУслуги, вариант Гистограмма: выполнение без ошибки: " + ТекстОтчета("ЦеныНаУслуги", Новый Структура("ДатаОтчета", '20260415'), "ОсновнаяСхемаКомпоновкиДанных", "Гистограмма") + "OK ---");
	// РейтингКлиентов: доход = выручка - стоимость
	ЗаписатьЛог(Лог, "--- РейтингКлиентов: выполнение без ошибки: " + ТекстОтчета("РейтингКлиентов") + "OK ---");
	ЗаписатьЛог(Лог, "Эталон дохода по клиентам (клиент | доход):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Р.Клиент.Наименование КАК Клиент, СУММА(Р.Выручка - Р.Стоимость) КАК Доход ИЗ РегистрНакопления.Продажи КАК Р СГРУППИРОВАТЬ ПО Р.Клиент.Наименование УПОРЯДОЧИТЬ ПО Доход УБЫВ"));
	// Универсальный
	ЗаписатьЛог(Лог, "--- Универсальный: выполнение без ошибки: " + ТекстОтчета("Универсальный") + "OK ---");
КонецПроцедуры
