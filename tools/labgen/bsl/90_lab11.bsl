//// ЛАБА 11: рейтинги услуг и материалов
Процедура Проверка_Лаб11(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 11 ===");
	П = Новый Структура("НачалоПериода,ДатаОкончания", '20260301', '20260430');
	ЗаписатьЛог(Лог, "--- Отчёт РейтингУслуг, 01.03-30.04 (красным выделены услуги с выручкой меньше 5000) ---");
	ЗаписатьЛог(Лог, ТекстОтчета("РейтингУслуг", П));
	ЗаписатьЛог(Лог, "Эталон из регистра Продажи (услуга | выручка):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Р.Номенклатура.Наименование КАК Услуга, СУММА(Р.Выручка) КАК СуммаВыручки ИЗ РегистрНакопления.Продажи КАК Р ГДЕ Р.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга) И Р.Период МЕЖДУ &ДатаНач И &ДатаКон СГРУППИРОВАТЬ ПО Р.Номенклатура.Наименование УПОРЯДОЧИТЬ ПО СуммаВыручки УБЫВ",
		Новый Структура("ДатаНач,ДатаКон", '20260301', '20260430235959')));
	ЗаписатьЛог(Лог, "--- Отчёт РейтингУслуг, только март ---");
	ЗаписатьЛог(Лог, ТекстОтчета("РейтингУслуг", Новый Структура("НачалоПериода,ДатаОкончания", '20260301', '20260331')));
	ЗаписатьЛог(Лог, "--- Отчёт РейтингМатериалов, 01.03-30.04 (красным выделены материалы с количеством меньше 3) ---");
	ЗаписатьЛог(Лог, ТекстОтчета("РейтингМатериалов", П));
	ЗаписатьЛог(Лог, "Эталон из регистра Продажи (материал | количество):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Р.Номенклатура.Наименование КАК Материал, СУММА(Р.Количество) КАК СуммаКоличества ИЗ РегистрНакопления.Продажи КАК Р ГДЕ Р.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Материал) И Р.Период МЕЖДУ &ДатаНач И &ДатаКон СГРУППИРОВАТЬ ПО Р.Номенклатура.Наименование УПОРЯДОЧИТЬ ПО СуммаКоличества УБЫВ",
		Новый Структура("ДатаНач,ДатаКон", '20260301', '20260430235959')));
КонецПроцедуры
