//// ЛАБА 12: Выручка мастеров (по дням, с дополнением периода) и вариант с диаграммой
Процедура Проверка_Лаб12(Лог)
	ЗаписатьЛог(Лог, "=== ЛАБА 12 ===");
	Текст = ТекстОтчета("ВыручкаМастеров", Новый Структура("НачалоПериода,ДатаОкончания", '20260301', '20260310'));
	ЗаписатьЛог(Лог, "--- Отчёт ВыручкаМастеров, основной вариант, 01.03-10.03 ---");
	ЗаписатьЛог(Лог, Текст);
	// 04.03 в документах нет: если период дополняется всеми днями, эта дата всё равно должна быть в отчёте
	ЗаписатьЛог(Лог, "Дата 04.03.2026 без продаж присутствует в отчёте (дополнение периода): " + ?(СтрНайти(Текст, "04.03.2026") > 0, "OK", "!!! все дни периода не выведены"));
	ЗаписатьЛог(Лог, "Дата 05.03.2026 (есть оказание услуги) присутствует: " + ?(СтрНайти(Текст, "05.03.2026") > 0, "OK", "!!! день с продажами не выведен"));
	// Вариант с диаграммой: проверяем, что схема строится и отчёт выполняется без ошибок
	ЗаписатьЛог(Лог, "--- Вариант ОбъемВыручки (диаграмма) ---");
	ЗаписатьЛог(Лог, "Выполнение: " + ТекстОтчета("ВыручкаМастеров", Новый Структура("НачалоПериода,ДатаОкончания", '20260301', '20260430'), "ОсновнаяСхемаКомпоновкиДанных", "ОбъемВыручки") + "(выполнено без ошибки)");
	ЗаписатьЛог(Лог, "Эталон: выручка по мастерам за период (мастер | выручка):");
	ЗаписатьЛог(Лог, ТекстЗапроса("ВЫБРАТЬ Р.Мастер.Наименование КАК Мастер, СУММА(Р.Выручка) КАК СуммаВыручки ИЗ РегистрНакопления.Продажи КАК Р ГДЕ Р.Период МЕЖДУ &ДатаНач И &ДатаКон СГРУППИРОВАТЬ ПО Р.Мастер.Наименование УПОРЯДОЧИТЬ ПО СуммаВыручки УБЫВ",
		Новый Структура("ДатаНач,ДатаКон", '20260301', '20260430235959')));
КонецПроцедуры
